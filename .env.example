# =====================================================================
# Mailu 2024.06.64 - plantilla de variables de entorno
# Copia este archivo a ".env" y completa los valores.
#
#   cp .env.example .env
#
# NUNCA subas el archivo .env a git ni lo pegues en un ticket.
# La clave SECRET_KEY, las contrasenas de administrador y las claves
# del relay viven aqui. Ver .gitignore.
#
# Referencia completa y verificada de todas las variables:
#   https://github.com/Mailu/Mailu/blob/2024.06.64/docs/configuration.rst
#   https://github.com/Mailu/Mailu/blob/2024.06.64/core/admin/mailu/configuration.py
#
# ESTADO DEL KIT: "kit preparado". No hay valores reales aqui.
# =====================================================================


# ---------------------------------------------------------------------
# 1. BLOQUE GENERADO POR EL ASISTENTE DE MAILU
# ---------------------------------------------------------------------
# La forma canonica de obtener un bloque valido es el asistente web
# oficial (https://setup.mailu.io/master/), que ademas genera el
# compose. Este kit esta basado en esa plantilla, pero el bloque se
# puede construir a mano. SECRETAKEY debe ser una cadena larga y
# aleatoria, distinta en cada instalacion:
#
#   openssl rand -hex 16
#
# NOTA: si usas el asistente, el bloque que entrega ya viene completo.
# No mezcles valores de dos instalaciones distintas.

# --- OBLIGATORIA ---
# Clave de firma de las sesiones del panel. Sin ella, el admin no
# arranca. Genera una sola vez y no la cambies nunca: cambiarla
# invalida las cookies y los tokens existentes.
SECRET_KEY=

# --- OBLIGATORIA ---
# Dominio principal del cliente, en minúsculas. Sin "mail." ni "https://".
# No uses un dominio que aun no controles.
DOMAIN=

# --- OBLIGATORIA ---
# Lista de nombres que este servidor respondera, separados por coma.
# El primero es el principal. Debe incluir el dominio de arriba.
# Si el cliente tiene subdominios de correo, agregalos aqui.
HOSTNAMES=

# --- OBLIGATORIA ---
# Red interna de Docker de Mailu. DEBE coincidir con RESOLVER_IP.
# Cambiarla despues de instalar deja el admin sin resolutor DNSSEC
# y este no arranca. Ver docs/03-VARIABLES-Y-COMO-OBTENERLAS.md.
SUBNET=192.168.203.0/24

# --- OBLIGATORIA ---
# Modo de TLS. Valores aceptados por Mailu: cert, letsencrypt, notls.
#   cert        = tu propio certificado (recomendado en produccion)
#   letsencrypt = el contenedor front pide el certificado solo
#   notls       = solo para pruebas, NO usar en produccion
# Ver docs/03-VARIABLES-Y-COMO-OBTENERLAS.md para elegir.
TLS_FLAVOR=cert

# --- OBLIGATORIA si TLS_FLAVOR=cert ---
# Ruta dentro del volumen "certs" del certificado y de la clave.
# Los archivos deben llamarse asi, con extension .pem.
TLS_CERT_FILENAME=cert.pem
TLS_KEYPAIR_FILENAME=key.pem

# --- OBLIGATORIA ---
# Correo del administrador. Aparece como remitente en los avisos
# del sistema y recibe los mensajes de rebote. Debe ser una casilla
# real y monitoreada del dominio del cliente.
POSTMASTER=postmaster@DOMINIO.cl

# --- OBLIGATORIA ---
# Desactivado por defecto. Mantenlo en "false": expone una API HTTP
# extra que no necesitas para administrar el servidor.
API=false

# --- OBLIGATORIA ---
# Mostrar el boton de administracion. No tiene el mismo significado
# que el valor ADMIN del CLI, que controla el acceso HTTP.
ADMIN=true

# --- Recomendada ---
# Subdominio del webmail. Se sirve en https://<WEBMAIL>.<DOMINIO>
WEBMAIL=webmail

# --- Recomendada ---
# Zona horaria del servidor, formato IANA.
TZ=America/Santiago

# --- Recomendada ---
# Cifrado de la clave en reposo (AES-256-CBC si no se indica).
ENCRYPTION_KEY=

# --- Opcional ---
# Selector DKIM. Es la etiqueta "v=DKIM1; k=rsa; p=..." del registro
# DNS. Si la cambias, hay que republicar el registro DNS.
DKIM_SELECTOR=dkim


# ---------------------------------------------------------------------
# 2. PUERTOS PUBLICADOS
# ---------------------------------------------------------------------
# Lista de puertos donde nginx DENTRO del contenedor escucha.
# Anadir o quitar un numero aqui NO publica ni despublica nada en el
# host: eso lo hace el bloque "ports" de compose.yaml.
#
# OBLIGATORIOS, no se pueden quitar: 25, 465, 993.
# El 587 NO viene activo por defecto en Mailu 2024.06. Si el cliente
# usa clientes de correo que necesitan el 587, agregalo aqui y al bloque
# ports de compose.yaml.
#
# Este kit deja fuera el 995 (POP3 cifrado). POP3 esta en desuso y
# casi ningun cliente moderno lo necesita. Si el cliente lo exige
# explicitamente, agrega 995 a esta lista y el puerto a compose.yaml.
# Nunca se publican 110 ni 143 (versiones sin cifrar).
PORTS=25,80,443,465,587,993,4190

# Direccion de la interfaz del host donde se publican los puertos.
# Lee con atencion docs/08-SERVICIOS-COMERCIALES.md: si pones
# 0.0.0.0 y tu proveedor NATea la maquina, el SPF del servidor va a
# fallar porque la IP de salida no sera la del dominio. Si tu servidor
# tiene IP publica propia, ponla aqui (por ejemplo 200.54.12.34).
BIND4=0.0.0.0
BIND6=

# Ultima IP utilizable de SUBNET, usada por el resolutor unbound.
# Si cambias SUBNET, cambia esto junto.
RESOLVER_IP=192.168.203.9

# Nombre del proyecto Compose. Determina los nombres de los volumenes
# (por ejemplo mailu_mail). Los scripts de respaldo lo usan.
COMPOSE_PROJECT_NAME=mailu

# Version de Mailu. Fija a la release verificada. Si la cambias sin
# cambiar el resto, estas corriendo otra version de la que probaste.
MAILU_VERSION=2024.06.64

# Puerto del host para cada servicio. Defaults = puertos reales.
# En un montaje de prueba mueve PUERTO_SMTP a 2525 para NO abrir el 25.
# Ver la advertencia del principio de compose.yaml.
PUERTO_SMTP=25
PUERTO_SUBMIT=587
PUERTO_SUBMITS=465
PUERTO_IMAPS=993
PUERTO_SIEVE=4190
PUERTO_HTTP=80
PUERTO_HTTPS=443


# ---------------------------------------------------------------------
# 3. PRIMER ADMINISTRADOR
# ---------------------------------------------------------------------
# El contenedor admin crea esta cuenta al arrancar. Los tres campos son
# OBLIGATORIOS en la primera ejecucion.
# INITIAL_ADMIN_MODE: create (crea, y falla si ya existe), ifmissing
# (crea solo si no existe) o update (fija la contrasena en cada arranque).
# Recomendado: ifmissing, para que puedas borrar la contrasena del .env
# despues de la primera vez sin romper nada.

# --- OBLIGATORIAS en la primera ejecucion ---
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=DOMINIO.cl
INITIAL_ADMIN_PW=
INITIAL_ADMIN_MODE=ifmissing

# Quita INITIAL_ADMIN_PW del .env una vez que la cuenta exista, si
# cambiaste INITIAL_ADMIN_MODE a ifmissing.


# ---------------------------------------------------------------------
# 4. REGLAS DE CORREO
# ---------------------------------------------------------------------
# --- OBLIGATORIA en la practica ---
# Limite de mensajes por usuario por dia. 0 desactiva el limite.
# Con la cuota abajo, 200 es comodo para una pyme.
MESSAGE_RATELIMIT=200

# --- Recomendada ---
# Tamano maximo de mensaje en bytes. ~47 MB.
MESSAGE_SIZE_LIMIT=50000000

# --- Recomendada ---
# Cuota por defecto del buzon en bytes. 1000000000 = 1 GB.
DEFAULT_QUOTA=1000000000

# --- Recomendada ---
# Caracter para las direcciones con_alias, por ejemplo
# juan+ventas@dominio.cl. Vacio lo desactiva.
RECIPIENT_DELIMITER=+

# --- Opcional ---
# Limite de intentos de autenticacion por IP, ventana de 5 minutos.
AUTH_RATELIMIT_IP=5
AUTH_RATELIMIT_IP_V4_MASK=24
AUTH_RATELIMIT_IP_V6_MASK=56
AUTH_RATELIMIT_USER=50
AUTH_RATELIMIT_EXEMPTION=
AUTH_RATELIMIT_EXEMPTION_LENGTH=86400

# --- Opcional ---
# Remitentes permitidos sin autenticacion. DEBE quedar vacio en
# produccion. Si lo rellenas, conviertes el servidor en un relay
# abierto: la usaran para spam y tu IP terminara en listas negras.
RELAYNETS=

# --- Opcional ---
# Altura de la cola de salida en bytes. 0 desactiva el limite.
# Limitar la cola evita acumular rebotes de forma indefinida.
QUEUE_RATELIMIT=

# --- Opcional ---
# Idiomas disponibles en la interfaz del panel.
LANGUAGES=en

# --- Opcional ---
# Desactiva las estadisticas de uso que Mailu muestra en el panel.
DISABLE_STATISTICS=False

# --- Opcional ---
# Lista de redes autorizadas a usar IMAP sin TLS.
# Vacio, y mantenlo vacio. Nunca lo publiques asi en produccion.
IMAP_AUTH_LAN=

# --- Opcional ---
# Denega IMAP desde redes distintas de las indicadas.
# Solo aplica si IMAP_AUTH_LAN esta definido.
IMAP_AUTH_NETWORKS=

# --- Opcional ---
# Fuerza IMAP sobre TLS puro (sin STARTTLS) para las redes indicadas.
IMAP_FORCE_TLS=

# --- Opcional ---
# Muestra la extension SIP para clientes malwares conocidos.
# Activala solo si sabes lo que hace.
DISABLE_MTA_STS=


# ---------------------------------------------------------------------
# 5. RELAY DE SALIDA (CRITICO, LEER LA SECCION 8 DE docs/)
# ---------------------------------------------------------------------
# Si tu proveedor de VPS tiene el PUERTO 25 SALIENTE bloqueado, Mailu
# no puede entregar correo a nadie. No hay error visible: el servidor
# acepta el correo y simplemente nunca sale.
#
# Un relay de salida de un proveedor transaccional resuelve el caso,
# pero cambia la arquitectura de entrega y obliga a revisar DMARC y la
# reputacion. Es la unica salida legitima. Este kit no incluye ninguna
# forma de evadir el bloqueo.
#
# RELAYHOST usa el formato [HOST]:PUERTO, con corchetes en la IP.
#   Leave vacio = envio directo desde tu propia IP.
#
# --- Opcionales ---
RELAYHOST=
RELAYUSER=
RELAYPASSWORD=


# ---------------------------------------------------------------------
# 6. MONTAJE DE PRUEBA (opcional, comentalo para produccion)
# ---------------------------------------------------------------------
# Comenta estas cuatro lineas para levantar un entorno de pruebas sin
# abrir el puerto 25. Es el unico camino aceptado para hacer pruebas:
# levantar el 25 sin DNS, DKIM, DMARC y PTR listos quema la IP.
# Detalle en docs/01-INSTALACION-DOCKER.md

# PUERTO_SMTP=2525
# PUERTO_SUBMIT=2587
# PUERTO_SUBMITS=2465
# PUERTO_IMAPS=2993


# ---------------------------------------------------------------------
# 7. TOKEN DE API (solo si API=true)
# ---------------------------------------------------------------------
# Si alguna vez necesitas API=true, OpenSSL genera este valor.
# Con API=false no se usa y puede quedar vacio.

# API_TOKEN=
